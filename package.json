{
  "name": "livemock-3d",
  "productName": "LiveMock 3D",
  "version": "0.1.0",
  "description": "Put any screen content onto a 3D device, animate it cinematically, export ready-to-edit video. Free forever.",
  "license": "MIT",
  "author": "LiveMock 3D contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/livemock/livemock-3d"
  },
  "main": "out/main/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "mediabunny": "1.62.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/three": "0.186.0",
    "@vitest/ui": "5.0.5",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
